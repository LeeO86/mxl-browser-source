{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "mbs-anim",
  "name": "Frame loop (lab test)",
  "description": "One continuously animated element per layer, the same as templates/frameloop/index.html draws per slot.",
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "schema": {
    "type": "object",
    "properties": {
      "slot": { "type": "integer", "label": "Slot", "minimum": 0, "maximum": 7, "default": 0 }
    }
  }
}
